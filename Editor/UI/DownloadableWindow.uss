.download-window { flex-grow: 1; }
.loading-view { flex-grow: 1; align-items: center; justify-content: center; }
.loading-content { width: 300px; max-width: 90%; align-items: stretch; }
.download-progress { margin-bottom: 8px; }
.loading-status { white-space: normal; -unity-text-align: middle-center; margin-bottom: 12px; }
.cancel { align-self: center; min-width: 90px; }
.retry { display: none; align-self: center; min-width: 90px; margin-top: 6px; }
.content { display: none; flex-grow: 1; min-height: 0; }
.file-panes { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; min-height: 0; overflow: hidden; }
.file-pane { flex-grow: 0; flex-shrink: 0; min-width: 140px; min-height: 0; overflow: hidden; }
.files { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; min-height: 0; }
.action-pane { flex-grow: 1; flex-shrink: 1; min-width: 220px; min-height: 0; overflow: hidden; }
.file-tab { flex-direction: row; align-items: center; flex-shrink: 0; min-height: 28px; margin: 0; padding: 4px 8px; border-width: 0; border-radius: 0; background-color: transparent; }
.file-tab:hover, .file-tab:active, .file-tab:focus { background-color: transparent; }
.file-tab.selected, .file-tab.selected:hover, .file-tab.selected:active, .file-tab.selected:focus { background-color: rgb(45, 105, 170); color: white; }
.file-tab > Label { margin: 0; flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.file-icon { width: 16px; height: 16px; margin-right: 6px; }
.empty-view { display: none; flex-grow: 1; flex-direction: row; align-items: center; justify-content: center; }
.empty-icon { width: 24px; height: 24px; margin-right: 8px; }
.empty-label { white-space: normal; }
.action-scroll { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; }
.file-actions { padding: 12px; }
.file-actions > Label { white-space: normal; margin-bottom: 8px; }
.footer { flex-shrink: 0; flex-direction: row; justify-content: flex-end; padding: 8px; border-top-width: 1px; border-top-color: rgba(128, 128, 128, 0.35); }
.footer > Button { margin-top: 0; }

.file-header { flex-direction: row; align-items: center; flex-shrink: 0; padding: 12px; border-bottom-width: 1px; border-bottom-color: rgba(128, 128, 128, 0.35); }
.file-header-icon { width: 20px; height: 20px; margin-right: 8px; flex-shrink: 0; }
.file-header-name { margin: 0; flex-grow: 1; flex-shrink: 1; min-width: 0; -unity-font-style: bold; white-space: normal; }
