<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="MainWindow.uss" />
    <ui:TwoPaneSplitView name="layout" view-data-key="main-split" fixed-pane-index="0" fixed-pane-initial-dimension="260" orientation="Horizontal" class="layout">
        <ui:VisualElement name="sidebar" class="sidebar">
            <uie:ToolbarMenu name="account-menu" class="account-menu" />
            <uie:ToolbarSearchField name="search" class="library-search" />
            <ui:ListView name="items" selection-type="Single" fixed-item-height="46" class="items" />
            <ui:VisualElement name="library-loading" class="library-loading">
                <ui:Image name="library-spinner" class="library-spinner" />
                <ui:Label name="incomplete-results" text="Not all items have been loaded yet." class="incomplete-results" />
            </ui:VisualElement>

        </ui:VisualElement>
        <ui:VisualElement class="main-pane">
            <ui:VisualElement name="login-prompt" class="login-prompt">
                <ui:VisualElement class="selection-message">
                    <ui:Image name="login-icon" class="selection-icon" />
                    <ui:Label text="You are not logged in." class="selection-text" />
                </ui:VisualElement>
                <ui:Button name="login-center" text="Log in to BOOTH" class="login-center" />
                <ui:Label name="login-status" class="login-status" />
            </ui:VisualElement>
            <ui:VisualElement name="selection-prompt" class="selection-prompt">
                <ui:VisualElement class="selection-message">
                    <ui:Image name="selection-icon" class="selection-icon" />
                    <ui:Label text="Select an item from the sidebar." class="selection-text" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="item-header" class="item-header">
                <ui:VisualElement name="image-glow" picking-mode="Ignore" class="image-glow" />
                <ui:Image name="item-image" scale-mode="ScaleToFit" class="item-image" />
                <ui:VisualElement class="header-text">
                    <ui:VisualElement name="title-link" class="title-link">
                        <ui:Label name="item-title" text="Select an item" class="item-title" />
                        <ui:Image name="external-link-icon" picking-mode="Ignore" class="external-link-icon" />
                    </ui:VisualElement>
                    <ui:VisualElement name="shop-info" class="shop-info">
                        <ui:Label text="by" picking-mode="Ignore" class="shop-by" />
                        <ui:VisualElement name="shop-icon" picking-mode="Ignore" class="shop-icon" />
                        <ui:Label name="shop-name" class="shop-name" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="main-view" mode="Vertical" horizontal-scroller-visibility="Hidden" class="main-view">
                <ui:VisualElement class="detail-content">
                    <ui:VisualElement name="detail-loading" class="detail-loading">
                        <ui:Image name="loading-spinner" class="loading-spinner" />
                    </ui:VisualElement>
                    <ui:Label name="detail-status" text="Item details will appear here." class="status" />
                    <ui:VisualElement name="downloads" class="downloads" />
                    <ui:Label name="description" enable-rich-text="true" class="description" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:TwoPaneSplitView>
</ui:UXML>
